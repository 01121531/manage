{
  "schema_version": 2,
  "production_acceptance": false,
  "receipt_authority": "vault-transit",
  "atomic_consumption": "postgresql-unique-secure-receipt-id",
  "bundle_schema_version": 2,
  "submission_key_binding": "spi:<vault-transit-signed-receipt-uuid>",
  "maximum_receipt_ttl_seconds": 600,
  "transit_keys": [
    {
      "key": "email-platform-card-import-receipt",
      "type": "ed25519",
      "derived": false,
      "exportable": false,
      "allow_plaintext_backup": false,
      "deletion_allowed": false,
      "auto_rotate_seconds": 2592000
    },
    {
      "key": "email-platform-mailbox-import-receipt",
      "type": "ed25519",
      "derived": false,
      "exportable": false,
      "allow_plaintext_backup": false,
      "deletion_allowed": false,
      "auto_rotate_seconds": 2592000
    }
  ],
  "target_smoke_check_count": 24,
  "roles": [
    {
      "role": "card-importer",
      "approle": "email-platform-card-importer",
      "policy": "email-platform-card-importer",
      "allowed": [
        "create-only secret/data/cards/imports/*; importer request uses cas=0",
        "update transit/sign/email-platform-card-import-receipt"
      ],
      "denied": ["kv read", "kv update", "kv list", "kv delete", "mailbox paths", "transit verify", "transit key export"]
    },
    {
      "role": "mailbox-importer",
      "approle": "email-platform-mailbox-importer",
      "policy": "email-platform-mailbox-importer",
      "allowed": [
        "create-only secret/data/mailboxes/imports/*; importer request uses cas=0",
        "update transit/sign/email-platform-mailbox-import-receipt"
      ],
      "denied": ["kv read", "kv update", "kv list", "kv delete", "card paths", "transit verify", "transit key export"]
    },
    {
      "role": "api-verifier",
      "approle": "email-platform-api-cards",
      "policy": "email-platform-api-cards",
      "allowed": [
        "update transit/verify/email-platform-card-import-receipt",
        "update transit/verify/email-platform-mailbox-import-receipt"
      ],
      "denied": ["transit sign", "transit key read", "transit key export", "pool secret write"]
    }
  ],
  "required_target_evidence": [
    "three_distinct_external_principals",
    "importer_create_only_effective_capability_and_cli_cas_zero_observed",
    "cross_pool_access_denied",
    "api_sign_denied",
    "importer_verify_denied",
    "transit_keys_non_exportable_and_rotated",
    "vault_audit_trace_reviewed",
    "database_concurrent_receipt_consumption_verified"
  ]
}
