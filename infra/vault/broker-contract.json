      "role_id_path": "auth/approle/role/email-platform-sub2/role-id",
      "secret_id_path": "auth/approle/role/email-platform-sub2/secret-id",
      "token_sink_directory_variable": "PLATFORM_VAULT_SUB2_TOKEN_DIR",
      "token_sink_leaf": "token",
      "secret_id_num_uses": 1,
      "secret_id_ttl_seconds": 600,
      "token_ttl_seconds": 900,
      "token_explicit_max_ttl_seconds": 3600,
      "positive_capabilities": {
        "auth/approle/role/email-platform-sub2/role-id": ["read"],
        "auth/approle/role/email-platform-sub2/secret-id": ["update"]
