      "service_policy": "email-platform-mail",
      "issuer_policy": "email-platform-broker-issuer-mail",
      "issuer_policy_file": "email-platform-broker-issuer-mail.hcl",
      "role_id_path": "auth/approle/role/email-platform-mail/role-id",
      "secret_id_path": "auth/approle/role/email-platform-mail/secret-id",
      "token_sink_directory_variable": "PLATFORM_VAULT_MAIL_TOKEN_DIR",
      "token_sink_leaf": "token",
      "secret_id_num_uses": 1,
      "secret_id_ttl_seconds": 600,
      "token_ttl_seconds": 900,
      "token_explicit_max_ttl_seconds": 3600,
      "positive_capabilities": {
        "auth/approle/role/email-platform-mail/role-id": ["read"],
        "auth/approle/role/email-platform-mail/secret-id": ["update"]
      },
      "denied_probe_paths": [
        "auth/approle/role/email-platform-mail",
        "auth/approle/role/email-platform-api-cards/role-id",
        "auth/approle/role/email-platform-api-cards/secret-id",
        "auth/approle/role/email-platform-sub2/role-id",
        "auth/approle/role/email-platform-sub2/secret-id",
        "auth/token/revoke-accessor",
        "secret/data/cards/canary",
        "secret/data/mailboxes/canary",
        "secret/data/sub2/credential",
        "sys/policies/acl/email-platform-broker-issuer-mail"
