{
  "schema_version": 1,
  "record_type": "kubernetes_external_secret_contract",
  "production_acceptance": false,
  "provider": "external_secret_manager_csi_or_operator",
  "secrets": [
    {
      "name": "platform-migration-runtime",
      "consumer": "migrate",
      "required_keys": ["migration-database-url"]
    },
    {
      "name": "platform-api-runtime",
      "consumer": "api",
      "required_keys": ["database-url", "redis-url", "vault-token"]
    },
    {
      "name": "platform-mail-runtime",
      "consumer": "worker-mail",
      "required_keys": ["database-url", "vault-token"]
    },
    {
      "name": "platform-sub2-runtime",
      "consumer": "worker-sub2",
      "required_keys": ["database-url", "redis-url", "vault-token"]
    },
    {
      "name": "platform-internal-ca",
      "consumer": "api,worker-mail,worker-sub2,web",
      "required_keys": ["ca.crt"]
    },
    {
      "name": "platform-api-internal-tls",
      "consumer": "api",
      "required_keys": ["tls.crt", "tls.key"]
    },
    {
      "name": "platform-worker-mail-internal-tls",
      "consumer": "worker-mail",
      "required_keys": ["tls.crt", "tls.key"]
    },
    {
      "name": "platform-worker-sub2-internal-tls",
      "consumer": "worker-sub2",
      "required_keys": ["tls.crt", "tls.key"]
    },
    {
      "name": "platform-web-internal-tls",
      "consumer": "web",
      "required_keys": ["tls.crt", "tls.key"]
    }
  ]
}
