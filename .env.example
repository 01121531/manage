# Copy to .env and replace every CHANGE_ME value with a secret-manager value.
# This file intentionally contains no usable production credentials.
# Production and rollback deployments must set every value to its matching
# immutable GHCR digest reference, for example
# ghcr.io/owner/email-platform-api@sha256:<64-hex-digest>. Empty values fail
# Compose interpolation. Local builds use docker-compose.dev.yml and
# .env.development.example explicitly.
# Do not define separate worker image variables: migrate, API and both workers
# intentionally run the exact same PLATFORM_API_IMAGE artifact.
PLATFORM_API_IMAGE=
PLATFORM_WEB_IMAGE=
PLATFORM_EDGE_IMAGE=
PLATFORM_RELEASE_TAG=unidentified
PLATFORM_RELEASE_COMMIT=unidentified
PLATFORM_RELEASE_MIGRATION_HEAD=unidentified
# The rolling executor supplies slot image and identity variables.  Operators
# configure only the protected route directory and the green-slot TLS leaves.
PLATFORM_ROLLING_ROUTE_DIR=/CHANGE_ME/rolling-edge-routing
PLATFORM_ROLLING_GREEN_API_CERT_FILE=/CHANGE_ME/internal-tls/api-green/tls.crt
PLATFORM_ROLLING_GREEN_API_KEY_FILE=/CHANGE_ME/internal-tls/api-green/tls.key
PLATFORM_ROLLING_GREEN_WEB_CERT_FILE=/CHANGE_ME/internal-tls/web-green/tls.crt
PLATFORM_ROLLING_GREEN_WEB_KEY_FILE=/CHANGE_ME/internal-tls/web-green/tls.key
# Resolve these five upstream images independently and set only their reviewed
# 64 lowercase hexadecimal digest fragments. Compose fixes the repository name
# and `@sha256:` prefix, so a mutable tag cannot enter the production topology.
POSTGRES_IMAGE_SHA256=
REDIS_IMAGE_SHA256=
KEYCLOAK_IMAGE_SHA256=
ALERTMANAGER_IMAGE_SHA256=
PROMETHEUS_IMAGE_SHA256=
POSTGRES_DB=email_platform
POSTGRES_USER=platform_migrator
POSTGRES_APP_USER=platform_app
KEYCLOAK_DB_USER=keycloak_app
# Absolute host paths managed outside Git. Each file is mounted read-only with
# create_host_path=false. URL files contain one complete URL on one line.
POSTGRES_PASSWORD_FILE=/CHANGE_ME/runtime-secrets/postgres/superuser-password
POSTGRES_APP_PASSWORD_FILE=/CHANGE_ME/runtime-secrets/postgres/platform-password
KEYCLOAK_DB_PASSWORD_FILE=/CHANGE_ME/runtime-secrets/postgres/keycloak-password
PLATFORM_MIGRATION_DATABASE_URL_FILE=/CHANGE_ME/runtime-secrets/platform/migration-database-url
PLATFORM_DATABASE_URL_FILE=/CHANGE_ME/runtime-secrets/platform/database-url
PLATFORM_REDIS_URL_FILE=/CHANGE_ME/runtime-secrets/platform/redis-url
# Redis configuration references the ACL file. The dedicated healthcheck user
# password is supplied to redis-cli over stdin and never appears in argv or the
# configured container environment.
REDIS_CONFIG_FILE=/CHANGE_ME/runtime-secrets/redis/redis.conf
REDIS_ACL_FILE=/CHANGE_ME/runtime-secrets/redis/users.acl
REDIS_HEALTHCHECK_PASSWORD_FILE=/CHANGE_ME/runtime-secrets/redis/healthcheck-password
# Contains Keycloak db/db-url/db-username/db-password and bootstrap-admin
# settings. Keep mode 0400/0440 and readable only by the Keycloak container UID.
KEYCLOAK_CONFIG_FILE=/CHANGE_ME/runtime-secrets/keycloak/keycloak.conf
PLATFORM_ENVIRONMENT=production
# FastAPI exact browser-origin allowlist. Native EXE/worker calls have no Origin.
PLATFORM_ALLOWED_ORIGINS=https://platform.example.com
# Maximum active devices admitted for one user. Set 0 only to freeze new device
# provisioning; it does not revoke or otherwise mutate devices already present.
PLATFORM_MAX_ACTIVE_DEVICES_PER_USER=5
# Required deployment input. Use an HTTPS Vault address outside development/test;
# keep this repository example empty so copying it cannot select a fake endpoint.
PLATFORM_VAULT_ADDR=
PLATFORM_VAULT_NAMESPACE=
PLATFORM_VAULT_TIMEOUT_SECONDS=10
# Development/test source placeholders only. For a direct non-Compose run, copy
# only the relevant value into that process's PLATFORM_VAULT_TOKEN. Production
# Compose never references these variables. Never reuse a token across services.
PLATFORM_VAULT_API_TOKEN=
PLATFORM_VAULT_MAIL_TOKEN=
PLATFORM_VAULT_SUB2_TOKEN=
# Production brokers atomically update <directory>/token. Each directory must
# be an absolute host path, readable by container UID 10001, and not in Git.
PLATFORM_VAULT_API_TOKEN_DIR=/CHANGE_ME/vault-agent/api
PLATFORM_VAULT_MAIL_TOKEN_DIR=/CHANGE_ME/vault-agent/mail
PLATFORM_VAULT_SUB2_TOKEN_DIR=/CHANGE_ME/vault-agent/sub2
# AppRole credentials are inputs to Vault Agent/an approved secret broker only;
# Compose never injects role_id or secret_id into application containers.
PLATFORM_VAULT_API_ROLE_ID=
PLATFORM_VAULT_API_SECRET_ID=
PLATFORM_VAULT_MAIL_ROLE_ID=
PLATFORM_VAULT_MAIL_SECRET_ID=
PLATFORM_VAULT_SUB2_ROLE_ID=
PLATFORM_VAULT_SUB2_SECRET_ID=
PLATFORM_MAIL_POLL_MODE=worker
PLATFORM_MAIL_API_URL=
# Absolute repository-external file containing one non-empty comma-separated
# line of exact HTTPS mail API origins (scheme, host and optional port only).
# This application control must be paired with production egress firewall or
# proxy ACL, DNS controls, and verified TLS; it is not a network sandbox.
PLATFORM_MAIL_ALLOWED_ORIGINS_FILE=/CHANGE_ME/mail/allowed-origins
PLATFORM_MAIL_TIMEOUT_SECONDS=20
PLATFORM_MAIL_CODE_TTL_SECONDS=60
# Card PAN reveal is fail-closed unless the OIDC access token proves this ACR
# after the server-created challenge. Configure the same ACR/LoA in Keycloak.
PLATFORM_CARD_STEP_UP_ACR=urn:email-platform:acr:mfa
PLATFORM_CARD_STEP_UP_CHALLENGE_TTL_SECONDS=120
PLATFORM_CARD_STEP_UP_GRANT_TTL_SECONDS=60
# A role change is only applied by a different platform administrator whose
# OIDC MFA authentication happened after the request was created.
PLATFORM_ADMIN_ROLE_CHANGE_ACR=urn:email-platform:acr:mfa
PLATFORM_ADMIN_ROLE_CHANGE_TTL_SECONDS=900
PLATFORM_SUB2_POLICY_VERSION=sub2-v1
PLATFORM_SUB2_GROUP_ID=49
# Unvalidated chapter-13 sizing default: 100 users / 10 concurrent tasks.
# Raise only after target load tests and an approved Sub2 provider limit.
PLATFORM_SUB2_CONCURRENCY=10
PLATFORM_SUB2_PROXY_REF=vault://secret/sub2/proxy
PLATFORM_SUB2_CREDENTIAL_REF=vault://secret/sub2/credential
# Development may omit this and keep the worker fail-closed. Production
# forward, rolling and rollback release commands require a reviewed endpoint.
PLATFORM_SUB2_UPLOAD_URL=
# Official Sub2 admin account API. These four settings belong only to
# worker-sub2. The API key value stays in Vault; never add a raw API key here.
PLATFORM_SUB2_ADMIN_BASE_URL=https://sub2.example.invalid/api/v1/admin
PLATFORM_SUB2_ADMIN_API_KEY_REF=vault://secret/sub2/admin
PLATFORM_SUB2_ADMIN_PROXY_ID=1
# Absolute host path to a reviewed, non-secret JSON object mapping model names.
PLATFORM_SUB2_ADMIN_MODEL_MAPPING_FILE=/CHANGE_ME/sub2/admin-model-mapping.json
# Absolute repository-external file containing one non-empty comma-separated
# line of exact HTTPS origins (scheme, host and optional port only). This is an
# application fail-closed control, not a substitute for production egress
# firewall/proxy ACL, DNS, or TLS verification.
PLATFORM_SUB2_ALLOWED_ORIGINS_FILE=/CHANGE_ME/sub2/allowed-origins
PLATFORM_WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
# Absolute host path managed outside Git. Production Compose has no repository
# fallback and refuses to start unless this read-only Alertmanager config exists.
# Keep receiver credentials in referenced secret files, never in this .env.
ALERTMANAGER_CONFIG_FILE=/CHANGE_ME/alertmanager/alertmanager.yml
PLATFORM_DOMAIN=platform.example.invalid
# Absolute host paths to a certificate covering PLATFORM_DOMAIN and
# identity.PLATFORM_DOMAIN. Files are mounted read-only into the edge container;
# never copy certificate private keys into the repository or container image.
PLATFORM_TLS_CERT_FILE=/run/secrets/email-platform-fullchain.pem
PLATFORM_TLS_KEY_FILE=/run/secrets/email-platform-privkey.pem
# Internal service certificates are issued by one private CA but every service
# uses a distinct certificate and private-key file. All paths are absolute host
# paths managed outside Git and mounted read-only with create_host_path=false.
PLATFORM_INTERNAL_CA_FILE=/CHANGE_ME/internal-tls/ca.crt
PLATFORM_INTERNAL_API_CERT_FILE=/CHANGE_ME/internal-tls/api/tls.crt
PLATFORM_INTERNAL_API_KEY_FILE=/CHANGE_ME/internal-tls/api/tls.key
PLATFORM_INTERNAL_WEB_CERT_FILE=/CHANGE_ME/internal-tls/web/tls.crt
PLATFORM_INTERNAL_WEB_KEY_FILE=/CHANGE_ME/internal-tls/web/tls.key
PLATFORM_INTERNAL_KEYCLOAK_CERT_FILE=/CHANGE_ME/internal-tls/keycloak/tls.crt
PLATFORM_INTERNAL_KEYCLOAK_KEY_FILE=/CHANGE_ME/internal-tls/keycloak/tls.key
PLATFORM_INTERNAL_WORKER_MAIL_CERT_FILE=/CHANGE_ME/internal-tls/worker-mail/tls.crt
PLATFORM_INTERNAL_WORKER_MAIL_KEY_FILE=/CHANGE_ME/internal-tls/worker-mail/tls.key
PLATFORM_INTERNAL_WORKER_SUB2_CERT_FILE=/CHANGE_ME/internal-tls/worker-sub2/tls.crt
PLATFORM_INTERNAL_WORKER_SUB2_KEY_FILE=/CHANGE_ME/internal-tls/worker-sub2/tls.key
PLATFORM_INTERNAL_PROMETHEUS_CERT_FILE=/CHANGE_ME/internal-tls/prometheus/tls.crt
PLATFORM_INTERNAL_PROMETHEUS_KEY_FILE=/CHANGE_ME/internal-tls/prometheus/tls.key
PLATFORM_INTERNAL_ALERTMANAGER_CERT_FILE=/CHANGE_ME/internal-tls/alertmanager/tls.crt
PLATFORM_INTERNAL_ALERTMANAGER_KEY_FILE=/CHANGE_ME/internal-tls/alertmanager/tls.key
# Only used with `docker compose --profile vault-dev up vault` locally.
# Never use Vault dev mode or a dev root token in staging/production.
VAULT_DEV_ROOT_TOKEN_ID=CHANGE_ME_LOCAL_ONLY_VAULT_DEV_TOKEN
